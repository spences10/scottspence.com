{
	"name": "scottspence.com",
	"version": "0.0.1",
	"private": true,
	"author": {
		"name": "Scott Spence",
		"email": "yo@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"start": "node ./build/index.js",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test:server": "vp test --project=server",
		"test:client": "vp test --project=client",
		"test:ssr": "vp test --project=ssr",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:ui": "vp test --ui",
		"test:ci": "vp test --run",
		"cspell": "cspell '**/*.md' --config cspell.json --wordsOnly",
		"coverage": "vp test --run --coverage"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1",
		"@types/d3-shape": "^3.2.0",
		"d3-shape": "^3.2.0",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@fontsource/comic-neue": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "6.0.0-next.12",
		"@sveltejs/kit": "3.0.0-next.27",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@twinkleplop/bash": "^0.1.5",
		"@twinkleplop/css": "^0.1.5",
		"@twinkleplop/diff": "^0.1.5",
		"@twinkleplop/dotenv": "^0.1.5",
		"@twinkleplop/html": "^0.1.5",
		"@twinkleplop/ini": "^0.1.5",
		"@twinkleplop/javascript": "^0.1.5",
		"@twinkleplop/json": "^0.1.5",
		"@twinkleplop/markdown": "^0.1.5",
		"@twinkleplop/markdown-core": "^0.1.5",
