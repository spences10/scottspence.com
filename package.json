		"@twinkleplop/tsx": "^0.1.5",
		"@twinkleplop/typescript": "^0.1.5",
		"@twinkleplop/yaml": "^0.1.5",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.2.0",
		"@typescript/native": "npm:typescript@^7.0.2",
