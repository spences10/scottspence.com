{
	"name": "scottspence.com",
	"version": "0.0.1",
	"private": true,
	"author": {
		"name": "Scott Spence",
		"email": "yo@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"start": "node ./build/index.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vitest",
		"test:server": "vitest --project=server",
		"test:client": "vitest --project=client",
		"test:ssr": "vitest --project=ssr",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:ui": "vitest --ui",
		"test:ci": "vitest run",
		"cspell": "cspell '**/*.md' --config cspell.json --wordsOnly",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1",
		"@types/d3-shape": "^3.2.0",
		"d3-shape": "^3.2.0",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@fontsource/comic-neue": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "next",
		"@sveltejs/kit": "3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.2.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"@vitest/browser": "5.0.0",
		"@vitest/browser-playwright": "5.0.0",
		"cspell": "^10.1.0",
		"d3-scale": "^4.0.2",
		"daisyui": "5.7.27",
		"date-fns": "4.4.0",
		"fathom-client": "3.7.2",
		"layerchart": "2.3.0",
		"marked": "18.0.10",
		"mdsvex": "^0.12.8",
		"mermaid": "^11.17.0",
		"playwright": "^1.62.1",
		"rehype-autolink-headings": "7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "6.0.0",
		"remark-preview": "1.0.3",
		"resend": "^6.22.0",
		"slugify": "1.6.9",
		"svead": "^0.0.16",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-turnstile": "^0.11.0",
		"sveltekit-embed": "^0.0.22",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"unist-util-visit": "5.1.0",
		"valibot": "^1.4.2",
		"vite": "^8.2.2",
		"vite-plus": "0.3.0",
		"vitest": "5.0.0",
		"vitest-browser-svelte": "^3.0.0"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.25.0"
}
