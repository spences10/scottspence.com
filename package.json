{
	"name": "scottspence.com",
	"version": "0.0.1",
	"private": true,
	"author": {
		"name": "Scott Spence",
		"email": "yo@scottspence.dev",
		"url": "https://scottspence.com"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"start": "node ./build/index.js",
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json --tsgo && pnpm check:posts",
		"check:posts": "node tools/check-posts.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --tsgo",
		"format": "vp check --fix",
		"lint": "vp check",
		"test:unit": "vp test",
		"test:server": "vp test --project=server",
		"test:client": "vp test --project=client",
		"test:ssr": "vp test --project=ssr",
		"test": "pnpm test:unit -- --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:ui": "vp test --ui",
		"test:ci": "vp test --run",
		"cspell": "cspell '**/*.md' --config cspell.json --wordsOnly",
		"coverage": "vp test --run --coverage"
	},
	"dependencies": {
		"@octokit/rest": "^22.0.1",
		"@types/d3-shape": "^3.2.0",
		"d3-shape": "^3.2.0",
		"sqlite-vec": "0.1.9"
	},
	"devDependencies": {
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@fontsource/comic-neue": "^5.3.0",
		"@mdsvex/language-server": "0.1.0-next.1",
		"@mdsvex/parse": "1.0.0-next.1",
		"@mdsvex/render": "1.0.0-next.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@twinkleplop/theme-night-owl": "^0.1.4",
		"@types/d3-scale": "^4.0.9",
		"@types/node": "^26.2.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"@vitest/browser": "5.0.1",
		"@vitest/browser-playwright": "5.0.1",
		"cspell": "^10.1.0",
		"d3-scale": "^4.0.2",
		"daisyui": "5.7.47",
		"date-fns": "4.4.0",
		"fathom-client": "3.7.2",
		"github-slugger": "^2.0.0",
		"hast-util-from-html": "^2.0.3",
		"hast-util-sanitize": "^5.0.2",
		"hast-util-to-html": "^9.0.5",
		"hast-util-to-text": "^4.0.2",
		"layerchart": "2.5.1",
		"marked": "18.0.14",
		"mdsvex": "1.0.0-next.1",
		"mermaid": "^12.0.0",
		"playwright": "^1.62.1",
		"resend": "^6.22.0",
		"slugify": "1.6.9",
		"svead": "^0.0.16",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-turnstile": "^0.11.0",
		"sveltekit-embed": "^0.0.22",
		"tailwindcss": "^4.3.3",
		"truncate-html": "^1.2.2",
		"typescript": "6.0.3",
		"valibot": "^1.4.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
		"vite-plus": "1.0.0",
		"vitest": "5.0.1",
		"vitest-browser-svelte": "^3.1.0",
		"vscode-jsonrpc": "^9.0.3",
		"vscode-languageserver-protocol": "^3.18.4",
		"yaml": "^2.9.0"
	},
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@12.8.1"
}
